<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.LiveChannels</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227</NoWarn>
    <!-- For the LibraryImport source generator (the hardlink syscalls in RecordingService); no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.LiveChannels.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="12.4.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin's own strings the pages and the server use, in every language Jellyfin has -->
    <JellyfinString Include="AnyLanguage" />
    <JellyfinString Include="Blacklist" />
    <JellyfinString Include="Bold" />
    <JellyfinString Include="ChannelNumber" />
    <JellyfinString Include="Channels" />
    <JellyfinString Include="Custom" />
    <JellyfinString Include="Default" />
    <JellyfinString Include="Delete" />
    <JellyfinString Include="Disabled" />
    <JellyfinString Include="Episode" />
    <JellyfinString Include="Episodes" />
    <JellyfinString Include="Filters" />
    <JellyfinString Include="Genre" />
    <JellyfinString Include="Guide" />
    <JellyfinString Include="HeaderError" />
    <JellyfinString Include="HeaderSubtitleAppearance" Case="sentence" />
    <JellyfinString Include="HeaderYears" />
    <JellyfinString Include="HomeVideos" Source="server" Case="sentence" />
    <JellyfinString Include="LabelAccessEnd" />
    <JellyfinString Include="LabelAccessStart" />
    <JellyfinString Include="LabelAudioCodec" />
    <JellyfinString Include="LabelCollection" />
    <JellyfinString Include="LabelFailed" />
    <JellyfinString Include="LabelFont" />
    <JellyfinString Include="LabelMetadata" />
    <JellyfinString Include="LabelNumber" />
    <JellyfinString Include="LabelSize" />
    <JellyfinString Include="LabelTextColor" />
    <JellyfinString Include="LabelTitle" />
    <JellyfinString Include="LabelVideoCodec" />
    <JellyfinString Include="Logo" />
    <JellyfinString Include="MediaInfoResolution" />
    <JellyfinString Include="Movie" />
    <JellyfinString Include="Movies" />
    <JellyfinString Include="MusicVideo" Case="sentence" />
    <JellyfinString Include="MusicVideos" Case="sentence" />
    <JellyfinString Include="Name" />
    <JellyfinString Include="Never" />
    <JellyfinString Include="New" />
    <JellyfinString Include="News" />
    <JellyfinString Include="None" />
    <JellyfinString Include="OptionRandom" />
    <JellyfinString Include="OptionSpecialEpisode" />
    <JellyfinString Include="People" />
    <JellyfinString Include="Refresh" />
    <JellyfinString Include="Reset" />
    <JellyfinString Include="Settings" />
    <JellyfinString Include="Shows" />
    <JellyfinString Include="Shuffle" />
    <JellyfinString Include="Sports" />
    <JellyfinString Include="Studios" />
    <JellyfinString Include="TitleHardwareAcceleration" Case="sentence" />
    <JellyfinString Include="TitlePlayback" />
    <JellyfinString Include="Unknown" />
    <JellyfinString Include="Upload" />
    <JellyfinString Include="Whitelist" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local strings whose English matches a Jellyfin string with another meaning, here a scheduled task category -->
    <JellyfinTextMatch Include="LabelLibrary" />
  </ItemGroup>

  <ItemGroup>
    <!-- Admin dashboard page -->
    <EmbeddedResource Include="Web\livechannels_channels.html" />
    <EmbeddedResource Include="Web\livechannels_channels.js" />
    <EmbeddedResource Include="Web\livechannels_settings.html" />
    <EmbeddedResource Include="Web\livechannels_settings.js" />
    <EmbeddedResource Include="Web\livechannels_popular.html" />
    <EmbeddedResource Include="Web\livechannels_popular.js" />
    <EmbeddedResource Include="Web\livechannels_sessions.html" />
    <EmbeddedResource Include="Web\livechannels_sessions.js" />
    <EmbeddedResource Include="Web\livechannels_placeholder.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Material Symbols font + name-to-codepoint map, used to render symbol channel logos -->
    <EmbeddedResource Include="Assets\MaterialSymbolsOutlined.ttf" />
    <EmbeddedResource Include="Assets\MaterialSymbolsOutlined.codepoints" />
    <EmbeddedResource Include="Assets\Fonts\Inter-Medium.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter-MediumItalic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Outfit-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Outfit-ExtraBold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Outfit-SemiBold.ttf" />
  </ItemGroup>

</Project>
